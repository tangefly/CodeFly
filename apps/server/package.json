{
  "name": "@codefly/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CODEFLY_DEV_WEB_URL=${CODEFLY_DEV_WEB_URL:-http://127.0.0.1:5173} tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codefly/protocol": "workspace:*",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^8.3.0",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "unpdf": "1.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
